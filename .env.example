# ==============================================================================
# CONVEX CONFIGURATION (Text metadata & reactive state)
# ==============================================================================
CONVEX_DEPLOYMENT=dev:honorable-raven-384
VITE_CONVEX_URL=https://honorable-raven-384.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://honorable-raven-384.eu-west-1.convex.site

# ==============================================================================
# CLOUDFLARE R2 CONFIGURATION (Video storage & global edge streaming)
# ==============================================================================
# Cloudflare R2 provides 10 GB free monthly storage, 10M read operations,
# and ZERO egress bandwidth fees.
#
# These variables should be added in:
# 1. Local development: `.env.local`
# 2. Production: Convex Dashboard (Settings > Environment Variables)
#
# Find your Account ID on the Cloudflare Dashboard right sidebar:
R2_ACCOUNT_ID="your-cloudflare-account-id"

# Created under Cloudflare Dashboard > R2 > Manage R2 API Tokens (Object Read & Write):
R2_ACCESS_KEY_ID="your-r2-api-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-api-secret-access-key"

# Name of your R2 bucket created in Cloudflare R2:
R2_BUCKET_NAME="fatah-portfolio-videos"

# Public URL for the bucket (either the *.r2.dev development subdomain or your custom domain):
# Example with R2.dev: https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Example with custom domain: https://media.fatahchafaa.com
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
